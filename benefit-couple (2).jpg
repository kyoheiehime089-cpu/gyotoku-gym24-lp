<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 720 520" role="img" aria-labelledby="title desc">
  <title id="title">Wi-Fi and speaker illustration</title>
  <desc id="desc">A clean flat illustration with Wi-Fi, speaker, tablet, and music notes.</desc>
  <defs>
    <linearGradient id="bg" x1="0" x2="1" y1="0" y2="1">
      <stop offset="0" stop-color="#ffffff"/>
      <stop offset="1" stop-color="#eef7f5"/>
    </linearGradient>
    <linearGradient id="screen" x1="0" x2="1" y1="0" y2="1">
      <stop offset="0" stop-color="#2d8c8c"/>
      <stop offset="1" stop-color="#18324b"/>
    </linearGradient>
    <filter id="softShadow" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="0" dy="16" stdDeviation="18" flood-color="#18324b" flood-opacity=".16"/>
    </filter>
  </defs>

  <rect width="720" height="520" rx="36" fill="url(#bg)"/>
  <circle cx="592" cy="108" r="72" fill="#fff4d8"/>
  <circle cx="132" cy="418" r="88" fill="#e4f2ef"/>
  <path d="M74 138c58-66 176-86 250-42 43 25 83 28 128 8 70-31 152-11 194 47" fill="none" stroke="#d9e8e8" stroke-width="16" stroke-linecap="round"/>

  <g filter="url(#softShadow)">
    <rect x="246" y="136" width="230" height="284" rx="34" fill="#ffffff"/>
    <rect x="270" y="176" width="182" height="190" rx="22" fill="url(#screen)"/>
    <circle cx="361" cy="394" r="12" fill="#dce8ea"/>
    <path d="M312 279c31-31 81-31 112 0" fill="none" stroke="#ffffff" stroke-width="15" stroke-linecap="round"/>
    <path d="M337 307c17-17 45-17 62 0" fill="none" stroke="#ffffff" stroke-width="13" stroke-linecap="round"/>
    <circle cx="368" cy="333" r="10" fill="#ffffff"/>
  </g>

  <g filter="url(#softShadow)">
    <rect x="88" y="214" width="134" height="172" rx="30" fill="#ffffff"/>
    <rect x="117" y="242" width="76" height="116" rx="20" fill="#18324b"/>
    <circle cx="155" cy="300" r="24" fill="#2d8c8c"/>
    <circle cx="155" cy="300" r="10" fill="#fff4d8"/>
    <path d="M214 265c22 18 22 52 0 70" fill="none" stroke="#2d8c8c" stroke-width="12" stroke-linecap="round"/>
    <path d="M238 240c42 39 42 98 0 137" fill="none" stroke="#a9d9d3" stroke-width="12" stroke-linecap="round"/>
  </g>

  <g filter="url(#softShadow)">
    <rect x="508" y="238" width="112" height="146" rx="28" fill="#ffffff"/>
    <path d="M535 284h38l26-25v105l-26-25h-38z" fill="#18324b"/>
    <path d="M612 292c15 15 15 40 0 55" fill="none" stroke="#e9bd52" stroke-width="12" stroke-linecap="round"/>
  </g>

  <g fill="none" stroke-linecap="round" stroke-linejoin="round">
    <path d="M501 112c40-33 98-33 138 0" stroke="#18324b" stroke-width="15"/>
    <path d="M531 145c22-18 56-18 78 0" stroke="#2d8c8c" stroke-width="13"/>
    <circle cx="570" cy="174" r="11" fill="#e9bd52" stroke="none"/>
  </g>

  <g fill="#e9bd52">
    <path d="M181 150v68c0 13-12 24-27 24s-27-11-27-24 12-24 27-24c6 0 11 2 16 4v-58z"/>
    <path d="M601 170v60c0 12-11 22-25 22s-25-10-25-22 11-22 25-22c5 0 10 1 14 4v-50z"/>
  </g>
  <g fill="#2d8c8c">
    <circle cx="230" cy="102" r="9"/>
    <circle cx="654" cy="308" r="8"/>
    <circle cx="95" cy="181" r="7"/>
    <circle cx="478" cy="441" r="8"/>
  </g>
</svg>
